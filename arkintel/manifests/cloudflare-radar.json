{
  "schema_version": "ark.intel.source.v1",
  "id": "cloudflare-radar",
  "label": "Cloudflare Radar",
  "group": "Infrastructure",
  "adapter": "cloudflare_radar_v1",
  "endpoint": {
    "scheme": "https",
    "hosts": [
      "api.cloudflare.com"
    ],
    "path_prefixes": [
      "/client/v4/radar"
    ],
    "redirects": "deny"
  },
  "transport": {
    "timeout_seconds": 8,
    "max_compressed_bytes": 5242880,
    "max_decompressed_bytes": 10485760,
    "max_records": 2000,
    "requests_per_minute": 6,
    "max_concurrency": 1
  },
  "freshness": {
    "poll_seconds": 90,
    "stale_after_seconds": 300,
    "expire_after_seconds": 900
  },
  "coverage": {
    "kind": "global_reported",
    "limitations": [
      "source_defined_detection_and_reporting"
    ]
  },
  "truth": {
    "class": "reported",
    "source_prior": 0.85,
    "method_version": "ark.intel.confidence.v1"
  },
  "license": {
    "identifier": "Cloudflare-terms",
    "terms_url": null,
    "terms_retrieved_at": null,
    "terms_sha256": null,
    "commercial_use": "allowed",
    "redistribution": "allowed",
    "attribution": "none",
    "retention": "allowed",
    "reviewed_at": "2026-09-21",
    "reviewed_by": "noah",
    "approval_ref": null,
    "notes": "Cloudflare API terms"
  },
  "privacy": {
    "class": "public_event",
    "personal_data": "none_expected"
  },
  "credentials": {
    "class": "api_token_governed",
    "governance_note": "Enable only with a dedicated read-only Radar token."
  },
  "cost": {
    "class": "free",
    "monthly_budget_usd": null
  },
  "retention": {
    "raw_hours": 24,
    "normalized_days": 30
  },
  "failure_semantics": {
    "empty_is_valid": true,
    "notes": null
  },
  "availability": "credential_required",
  "admission_note": "Enable only with a dedicated read-only Radar token."
}
